<?xml version="1.0" encoding="utf-8"?>

<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
    <changeSet
        id="20260827120000-1"
        author="raul"
        context="prod"
    >
        <delete tableName="jhi_user_authority">
            <where>
                user_id IN (
                    SELECT id
                    FROM jhi_user
                    WHERE
                        (
                            id = 1
                            AND login = 'admin'
                            AND email = 'admin@localhost'
                        )
                        OR
                        (
                            id = 2
                            AND login = 'user'
                            AND email = 'user@localhost'
                        )
                )
            </where>
        </delete>

        <delete tableName="jhi_user">
            <where>
                (
                    id = 1
                    AND login = 'admin'
                    AND email = 'admin@localhost'
                )
                OR
                (
                    id = 2
                    AND login = 'user'
                    AND email = 'user@localhost'
                )
            </where>
        </delete>
    </changeSet>
</databaseChangeLog>